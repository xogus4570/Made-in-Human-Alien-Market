  dialogueBackground: {fileID: 1611773625}
  endingText: {fileID: 452443670}
  nextButton: {fileID: 1198083892}
  endings:
  - endingType: 0
    endingPanel: {fileID: 851863345}
    endingImages:
    - {fileID: 547232062}
    - {fileID: 547232062}
    - {fileID: 547232062}
    - {fileID: 100415070}
    - {fileID: 100415070}
    - {fileID: 100415070}
    - {fileID: 100415070}
    - {fileID: 1795435431}
    - {fileID: 1795435431}
    - {fileID: 1682248693}
    - {fileID: 1682248693}
    - {fileID: 1682248693}
    - {fileID: 1682248693}
    endingTexts:
    - "(\uB9C8\uC9C0\uB9C9 \uC601\uC5C5\uC77C. \uBAA8\uB4E0 \uACC4\uC0B0\uC774 \uB05D\uB0AC\uB2E4.)\r\n"
    - "\u201C...\uC774\uAC8C \uC804\uBD80\uC57C. \n\uB0B4\uAC00 \uC774 \uD0C8 \uD558\uB098\uB85C
      \uC313\uC544 \uC62C\uB9B0 \uAC83\uB4E4.\u201D\r\n"
    - "\u201C\uB3C8. \uADF8\uB9AC\uACE0 \uADF8 \uB3C8\uC73C\uB85C \uC0B0 \uAC83\uB4E4.\u201D\r\n\r\n"
    - "\u201C...\uB2F9\uC2E0\uC774 \uADF8 \uC0C1\uC778\uC774\uC624? \uC678\uACC4\uC778
      \uD589\uC138\uB97C \uD558\uBA70 \uADF8\uB4E4\uC758 \uB3C8\uC744 \uBE7C\uC557\uB358?\u201D\r\n"
    - "\u201C\uADF8\uB798. \uADF8\uB9AC\uACE0 \uADF8 \uB3C8\uC744 \uC5EC\uAE30 \uAC00\uC838\uC654\uC5B4.
      \uC804\uBD80.\u201D\r "
    - "\u201C\uB098\uB294 QQQ\uC871\uC758 \uC790\uBCF8 \uAD6C\uC870\uAC00 \uC5B4\uB5BB\uAC8C
      \uB3CC\uC544\uAC00\uB294\uC9C0 \uC548\uB2E4. \uADF8\uB4E4\uC774 \uC5B4\uB5A4
      \uC885\uC871\uC744 \uD3B8\uC560\uD558\uB294\uC9C0, \uC5B4\uB290 \uB77C\uC778\uC5D0
      \uADE0\uC5F4\uC774 \uC788\uB294\uC9C0. \uB0B4\uAC00 \uADF8\uB4E4\uC758 \uCDE8\uD5A5\uC744
      \uD30C\uACE0\uB4E4\uBA70 \uBC30\uC6B4 \uAC83\uB4E4\uC774\uC57C.\u201D\r\n"
    - "...\uC6B0\uB9AC\uAC00 \uD544\uC694\uD55C \uAC8C \uCD1D\uC774 \uC544\uB2CC
      \uC774\uC720\uB97C \uC774\uC81C \uC54C\uACA0\uAD70.\u201D\r\n"
    - "\uAE34\uAE09 \uC18D\uBCF4\uC785\uB2C8\uB2E4. \uC740\uD558 \uC5F0\uD569 \uB0B4
      \uB2E4\uC218 \uC885\uC871 \uAC04\uC758 \uC790\uBCF8 \uCDA9\uB3CC\uC774 \uAC10\uC9C0\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC9C4\uC6D0\uC9C0\uB294\u2014\r\n"
    - "(\uD55C \uC778\uAC04\uC774 \uC2EC\uC5B4 \uB193\uC740 \uCDE8\uD5A5\uC758 \uC528\uC557\uB4E4\uC774,
      \uC774\uC81C \uC11C\uB85C\uB97C \uD5A5\uD574 \uC790\uB77C\uAE30 \uC2DC\uC791\uD588\uB2E4.)\r\n"
    - "\uADF8\uB4E4\uC774 \uB5A0\uB0AC\uB2E4. \uCD1D\uC131 \uD55C \uBC1C \uC5C6\uC774."
    - "\u201C...\uB410\uC5B4. \uC9C4\uC9DC \uB410\uC5B4.\u201D\r\n"
    - "\u201C(\uD0C8\uC744 \uB0B4\uB824\uB2E4\uBCF4\uBA70) \uACE0\uC0DD\uD588\uB2E4.\u201D"
    - "\uC778\uB958\uAC00 \uBE7C\uC557\uACBC\uB358 \uBBF8\uB798\uB294, \uD55C \uC778\uAC04\uC758
      \uC9D1\uC694\uD55C \uC7A5\uC0AC \uC218\uC644\uC73C\uB85C \uB418\uB3CC\uC544\uC654\uB2E4."
  - endingType: 1
    endingPanel: {fileID: 1221283884}
    endingImages:
    - {fileID: 868405431}
    - {fileID: 868405431}
    - {fileID: 868405431}
    - {fileID: 1566998047}
    - {fileID: 1566998047}
    - {fileID: 1566998047}
    endingTexts:
    - "(\uB9C8\uC9C0\uB9C9 \uC601\uC5C5\uC77C\uC774 \uB05D\uB0AC\uB2E4. \uADF8\uB9AC\uACE0
      \uADF8 \uB05D\uC740, \uAF64 \uAD1C\uCC2E\uC740 \uC790\uB9AC\uC600\uB2E4.)\r\n"
    - "\u201C\uB098\uC058\uC9C0 \uC54A\uC544. \uC544\uB2C8, \uC194\uC9C1\uD788 \uB9D0\uD558\uBA74...
      \uAF64 \uC88B\uC544.\u201D\r\n"
    - "\u201C...\uC5B4\uCA54 \uC218 \uC5C6\uC5B4. \uB0B4\uAC00 \uD560 \uC218 \uC788\uB294
      \uAC74 \uB2E4 \uD588\uC5B4.\u201D\r\n"
    - "(\uD14C\uC774\uBE14 \uC704 \uBC18\uCBE4 \uC811\uD78C \uC885\uC774 \uD55C \uC7A5
      \u2014 \uC800\uD56D\uAD70\uC5D0\uC11C \uC654\uB358 \uC5F0\uB77D\uCC98. \uADF8\uAC83\uC744
      \uC7A0\uC2DC \uBC14\uB77C\uBCF4\uB2E4, \uC885\uC774\uB97C \uBC00\uC5B4 \uBC84\uB9B0\uB2E4.)\r\n"
    - "\u201C\uC774\uAC8C \uD569\uB9AC\uC801\uC778 \uC120\uD0DD\uC774\uC57C. \uC0B4\uC544\uB0A8\uB294
      \uAC8C \uBA3C\uC800\uC57C.\u201D\r\n"
    - "(\uADF8 \uB9D0\uC774 \uB9DE\uB294\uC9C0 \uD2C0\uB9B0\uC9C0\uB294, \uC544\uBB34\uB3C4
      \uC54C \uC218 \uC5C6\uC5C8\uB2E4. \uADF8 \uC790\uC2E0\uC870\uCC28.)"
  - endingType: 2
    endingPanel: {fileID: 1142750732}
    endingImages:
    - {fileID: 1762806807}
    - {fileID: 1762806807}
    - {fileID: 1762806807}
    - {fileID: 1735473003}
    - {fileID: 1735473003}
    - {fileID: 1735473003}
    - {fileID: 1735473003}
    - {fileID: 1735473003}
    endingTexts:
    - "\u201C...\uB05D\uB0AC\uB124.\u201D"
    - "\u201C\uADFC\uB370 \uBB50, \uAD1C\uCC2E\uC544.\u201D"
    - "\u201C(\uD0C8\uC744 \uAF49 \uC950\uBA70) \uB09C \uC544\uC9C1 \uC548 \uB05D\uB0AC\uAC70\uB4E0.\u201D"
    - "\u201C\uB3C8\uC740 \uB2E4\uC2DC \uBC8C\uBA74 \uB3FC. \uBC29\uBC95\uC740 \uC54C\uACE0
      \uC788\uC73C\uB2C8\uAE4C.\u201D\r\n"
    - "\u201C\uB2E4\uC74C\uC5D4 \uC9C4\uC9DC\uB85C \uD574\uC57C\uC9C0. \uC81C\uB300\uB85C.\u201D"
    - "\u201C...\uBC18\uB4DC\uC2DC.\u201D"
    - "(\uADF8\uAC00 \uB9D0\uD558\uB294 '\uB2E4\uC74C'\uC774 \uC5B8\uC81C\uC778\uC9C0\uB294,
      \uC544\uBB34\uB3C4 \uBAB0\uB790\uB2E4.)\r\n"
    - "(\uC5B4\uCA4C\uBA74, \uADF8 \uC790\uC2E0\uB3C4.)\n\r\n"
  - endingType: 3
    endingPanel: {fileID: 2029790187}
    endingImages:
    - {fileID: 470164661}
    - {fileID: 470164661}
    - {fileID: 470164661}
    - {fileID: 470164661}
    - {fileID: 470164661}
    - {fileID: 1077529240}
    - {fileID: 1077529240}
    - {fileID: 1077529240}
    endingTexts:
    - "\u201C\uCC44\uBB34 \uBD88\uC774\uD589. \uBCF8 \uC2DC\uC124 \uBC0F \uBAA8\uB4E0
      \uC7AC\uC0B0\uC744 \uC989\uC2DC \uC555\uB958\uD569\uB2C8\uB2E4.\u201D\r\n"
    - "\u201C...\uADF8\uB798. \uC774\uB807\uAC8C \uB05D\uB098\uB294 \uAC70\uAD6C\uB098.\u201D"
    - " \u201C(\uBA85\uB839\uC11C\uB97C \uB0B4\uBC00\uBA70) \uAD6C\uC5ED C-7 \uB178\uB3D9
      \uBC30\uC815. \uC774\uC758 \uC5C6\uC73C\uBA74 \uC11C\uBA85\uD558\uB77C.\u201D"
    - ...
    - "\u201C(\uCC9C\uCC9C\uD788 \uC190\uC744 \uBED7\uC73C\uBA70) ...\uADF8\uB7EC\uC9C0
      \uBB50.\u201D"
    - "(\uC2DC\uC791\uACFC \uAC19\uC740 \uC790\uB9AC\uC600\uB2E4.)"
    - "\u201C\uBB50\uAC00 \uB2EC\uB77C\uC9C4 \uAC70\uC9C0. \uB098\uB294 \uBB58 \uD55C
      \uAC70\uC57C.\u201D"
    - "(\uC778\uB958\uB294 \uADF8\uB0A0\uB3C4, \uADF8\uB2E4\uC74C \uB0A0\uB3C4, \uC678\uACC4\uC758
      \uD558\uB298 \uC544\uB798 \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4. \uADF8\uB9AC\uACE0
      \uD55C \uC778\uAC04\uC758 \uC774\uC57C\uAE30\uB294, \uC544\uBB34 \uD754\uC801\uB3C4
      \uB0A8\uAE30\uC9C0 \uBABB\uD55C \uCC44 \uC78A\uD600\uC84C\uB2E4.)"
  titleSceneName: Title
