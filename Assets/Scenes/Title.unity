--- !u!114 &1675846845
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1675846844}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5059a2ac205009241821a25b28bed311, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryController
  titleMenuPanel: {fileID: 2024422211}
  storyPanel: {fileID: 2023633227}
  nextButton: {fileID: 1136486086}
  storyImages:
  - {fileID: 2113864037}
  - {fileID: 2113864037}
  - {fileID: 257969137}
  - {fileID: 257969137}
  - {fileID: 1258485699}
  - {fileID: 1258485699}
  - {fileID: 1258485699}
  - {fileID: 1845181116}
  - {fileID: 1845181116}
  - {fileID: 1845181116}
  - {fileID: 1845181116}
  - {fileID: 752600782}
  - {fileID: 752600782}
  - {fileID: 74976209}
  - {fileID: 74976209}
  storyText: {fileID: 1910898915}
  blackOverlay: {fileID: 1199839265}
  introText: {fileID: 1063304604}
  storyTexts:
  - "\"\uC778\uB958\uC758 \uBB38\uBA85\uC740 \uADF8\uB4E4\uC758 \uC555\uB3C4\uC801\uC778
    \uAE30\uC220\uB825 \uC55E\uC5D0 \uB2E8 \uBA87 \uC2DC\uAC04 \uB9CC\uC5D0 \uBB34\uB825\uD558\uAC8C
    \uBB34\uB108\uC838 \uB0B4\uB838\uB2E4.\""
  - " \"\uC804\uC7C1\uC740 \uD5C8\uBB34\uD560 \uC815\uB3C4\uB85C \uC2F1\uAC81\uAC8C
    \uB05D\uB0AC\uB2E4. \uADF8\uB4E4\uC740 \uC9C0\uAD6C\uC778\uC744 \uBA78\uC885\uC2DC\uD0A4\uC9C0
    \uC54A\uC558\uB2E4. \n\uADF8\uC800... \uC870\uAE08 \uB354 \uACE0\uB4F1\uD55C
    \uAC00\uCD95\uC774\uC790, \uC2DD\uBBFC\uC9C0\uC758 \uBD80\uC18D\uD488\uC73C\uB85C
    \uC0BC\uC558\uC744 \uBFD0.\""
  - "\"...\uBAA8\uB4E0 \uAC83\uC744 \uC783\uC5C8\uB2E4. \uAC00\uC871\uB3C4, \uCE5C\uAD6C\uB3C4,
    \uB0B4\uAC00 \uC0AC\uB791\uD558\uB358 \uC138\uACC4\uB3C4. \uC774\uC81C \uB0B4\uAC8C
    \uB0A8\uC740 \uAC74 \uC808\uB9DD\uBFD0\uC778\uAC00...?\""
  - "\u201C\uC774\uB807\uAC8C \uC678\uACC4\uC778 \uB188\uB4E4\uC758 \uB178\uC608\uAC00
    \uB418\uB294\uAC70\uAD6C\uB098\u2026\u201D"
  - "\"\uB00D! \uB044\uC774\uC775! (\uD589\uBCF5\uD574\uBCF4\uC778\uB2E4.)\""
  - "\uC5B4...? \uC800 \uB140\uC11D, \uC9C0\uAE08 \uBB58 \uD558\uACE0 \uC788\uB294
    \uAC70\uC9C0? \uD53C\uADDC\uC5B4\uB97C \uBCF4\uACE0 \uC800\uB807\uAC8C \uAE30\uBED0\uD55C\uB2E4\uACE0...?\""
  - "\"\uD53C\uADDC\uC5B4\u2026? \uC544 \uADF8\uB798!\u201D"
  - "(\"\uC8FC\uC778\uACF5\uC740 \uACB0\uC2EC\uD55C\uB4EF \uC678\uACC4\uC778 \uD0C8\uC744
    \uB4A4\uC9D1\uC5B4\uC4F4\uB2E4.\")"
  - "\"\uADF8\uB798, \uCD1D\uACFC \uCE7C\uB85C\uB294 \uC800 \uC678\uACC4\uC778\uB4E4\uC744
    \uB2E8 \uD55C \uB9C8\uB9AC\uB3C4 \uC8FD\uC77C \uC218 \uC5C6\uC5B4. \n\uD558\uC9C0\uB9CC...
    \uC800\uB4E4\uC744  \uC9C0\uBC30\uD560 \uC218 \uC788\uB2E4\uBA74 \uC598\uAE30\uAC00
    \uB2E4\uB974\uC9C0.\""
  - "\"\uC678\uACC4\uC778\uC740 \uACFC\uC2DC\uB97C \uC88B\uC544\uD558\uB2C8\uAE4C
    \uBCF4\uC11D\uC744 \uC4F0\uB294 \uAC70\uC57C. \uC774\uAC78\uB85C \uC885\uC871\uBCC4
    \uB300\uD45C\uC0C9\uC744 \uD45C\uD604\uD558\uB294 \uAC70\uC9C0. \n\uADF8\uB4E4\uC744
    \uCDE8\uD5A5\uC744 \uBC18\uC601\uD55C \uAD7F\uC988\uB97C \uB9CC\uB4E4\uC5B4 \uD30C\uB294\uAC70\uC9C0.\""
  - "\"QQQ\uC871\u2026 \uB108\uD76C\uB4E4\uC758 \uC798\uB09C \uC790\uBCF8\uC744 \uB0B4\uAC00
    \uC811\uC218\uD558\uACA0\uC5B4.\""
  - "\"(\uCE58\uC774- \uC775...) \uC544, \uC544. \uC704\uB300\uD55C \uC740\uD558
    \uC5F0\uD569 \uACE0\uAC1D\uB2D8\uB4E4! \uBAA8\uB450 \uC8FC\uBAA9\uD558\uC2ED\uC2DC\uC624!\""
  - "\"\uC5EC\uB7EC\uBD84\uC758 \uCDE8\uD5A5\uC774 \uB4EC\uBFCD \uB2F4\uAE34 \uC6B0\uC8FC
    \uAD7F\uC988\uB97C \uD310\uB9E4\uD569\uB2C8\uB2E4!\u201D"
  - " '\uC644\uBCBD\uD558\uAC8C \uC18D\uC544 \uB118\uC5B4\uAC00\uB294\uAD70, \uBA4D\uCCAD\uD55C
    \uC678\uACC4\uC778\uB4E4. \uC804 \uC7AC\uC0B0\uC744 \uBC14\uCCD0\uB77C!'"
  - "\"\uC815\uCCB4\uB97C \uC228\uAE30\uACE0, \uADF8\uB4E4\uC758 \uCDE8\uD5A5\uC744
    \uC644\uBCBD\uD558\uAC8C \uC800\uACA9\uD574 \uC6B0\uC8FC \uCD5C\uACE0\uC758 \uAC70\uC0C1\uC774
    \uB418\uC5B4... \n\uB3C8\uACFC \uC601\uD5A5\uB825\uC73C\uB85C, \uBE7C\uC557\uAE34
    \uC778\uB958\uC758 \uBBF8\uB798\uB97C \uBC18\uB4DC\uC2DC \uB418\uC0AC\uACA0\uC5B4.\""
  introStoryText: "20XX\uB144, \uC740\uD558 \uC5F0\uD569 \uCD5C\uAC15\uC758 \uC885\uC871
    'QQQ'\uAC00 \uC9C0\uAD6C\uC5D0 \uB2F9\uB3C4\uD588\uB2E4."
  typingSpeed: 0.04
  fadeSpeed: 0.7
